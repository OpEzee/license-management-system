# Server
PORT=5000
NODE_ENV=development

# CORS — comma separated list of allowed origins for the ADMIN APIs
CORS_ORIGIN=http://localhost:5173

# Who may show the /client pages (the product-facing sign-in and license
# screens) in a frame. Leave blank to allow any product, including an installed
# Electron app loading from file://. Comma separated, e.g. https://kiosk.example.com
CLIENT_FRAME_ANCESTORS=

# The staff PIN of the hosted /client/pin page (4 to 8 digits), in front of a
# product's licence details. Not set: the page says the PIN is not set up.
CLIENT_PIN=1968

# true only when the server is reached over plain http:// (e.g. an EC2 test without
# a domain): drops the upgrade-insecure-requests header, which would make browsers
# fetch the dashboard over https:// and leave it blank. Leave unset behind https.
# ALLOW_HTTP=true

# MongoDB. Defaults to a local server on the standard port.
# With authentication: mongodb://user:password@127.0.0.1:27017/?authSource=admin
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=opezee_licenses

# Admin authentication
# Generate a strong secret with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-secret-at-least-16-chars
TOKEN_EXPIRES_IN=12h

# Used by `npm run create-admin` to create/reset the dashboard login
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password
ADMIN_NAME=Administrator

# --- Email sending (optional) -----------------------------------------------
# The database cannot send email; these are the SMTP details of a mail provider.
# Leave blank and the console falls back to opening your own mail client.
# Gmail / Google Workspace: smtp.gmail.com, port 587, and an App Password
# (NOT your normal password) from https://myaccount.google.com/apppasswords
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional: true forces implicit TLS. Leave blank to infer from the port.
SMTP_SECURE=
# The From address shown to recipients. Defaults to SMTP_USER.
MAIL_FROM=
MAIL_FROM_NAME=Opezee Licenses


# --- Dashboard (Vite) --------------------------------------------------------
# The dashboard calls a relative /api: in production Express serves the build
# from the same origin, and in development Vite proxies /api to PORT above.
# Only set this to point the dashboard at a different host entirely.
# VITE_API_BASE_URL=
